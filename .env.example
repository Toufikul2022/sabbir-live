# ─── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Contact form delivery (configure ONE of the two options) ────────────
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
# Sender address. With Resend this must be on a domain you verified in Resend.
CONTACT_FROM_EMAIL=

# Option A — Resend (https://resend.com, free tier available)
RESEND_API_KEY=

# Option B — any SMTP server (Gmail app password, Zoho, Outlook, your host…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for port 465 (implicit TLS); leave empty for 587/STARTTLS.
SMTP_SECURE=

# Optional spam protection — Cloudflare Turnstile (free).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional automatic video sync ───────────────────────────────────────
# YouTube: no API key needed. Set the channel ID (starts with "UC") here or
# in content/site.json → youtube.channelId.
YOUTUBE_CHANNEL_ID=

# Facebook: requires a Meta app and a long-lived Page access token
# (see README → "Automatic Facebook sync").
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0

# ─── /manage: add TikTok videos from a phone (no coding) ─────────────────
# Password the owner types to log in at /manage.
MANAGE_PASSWORD=
# GitHub fine-grained token with "Contents: Read and write" on this repository.
GITHUB_TOKEN=
GITHUB_REPO=Toufikul2022/sabbir-live
GITHUB_BRANCH=main
